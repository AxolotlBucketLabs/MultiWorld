{
  "name": "czechpmdevs/multiworld",
  "description": "An advanced world management PocketMine plugin with custom world generators.",
  "minimum-stability": "dev",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.4",
    "ext-yaml": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "cortexpe/commando": "dev-PM5",
    "czechpmdevs/libpmform": "dev-main",
    "muqsit/vanillagenerator": "dev-master",
    "muqsit/simple-packet-handler": "^0.1.10",
    "axolotl-pm/pocketmine-mp": "5.51.2",
    "phpstan/phpstan": "2.1.46"
  },
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/axolotl-pm/PocketMine-MP"
    },
    {
      "type": "vcs",
      "url": "https://github.com/CzechPMDevs/libpmform"
    },
    {
      "type": "vcs",
      "url": "https://github.com/CzechPMDevs/VanillaGenerator"
    },
    {
      "type": "vcs",
      "url": "https://github.com/ACM-PocketMine-MP/Commando/"
    },
    {
      "type": "vcs",
      "url": "https://github.com/AxolotlBucketLabs/SimplePacketHandler"
    }
  ],
  "autoload": {
    "psr-4": {
      "czechpmdevs\\multiworld\\": "src/czechpmdevs/multiworld/"
    }
  }
}
